# --- Server ---
PORT=3000

# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/job_tracker
# Set to true for managed databases that require SSL (Render, Neon, Supabase...)
DATABASE_SSL=false

# --- Resend (https://resend.com/api-keys) ---
RESEND_API_KEY=re_your_api_key_here
# With the default sandbox sender you can only email your own Resend account address.
# Verify a domain in Resend to send to anyone.
EMAIL_FROM=Job Tracker <onboarding@resend.dev>

# --- Email queue worker ---
# true = worker runs inside the API process (monolith). false = run `npm run worker` separately.
RUN_WORKER=true
WORKER_POLL_MS=2000
# Retries after the first failed attempt (total attempts = 1 + EMAIL_MAX_RETRIES)
EMAIL_MAX_RETRIES=3
# Backoff: base * 2^attempt seconds
EMAIL_RETRY_BASE_SECONDS=30
